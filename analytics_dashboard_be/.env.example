# Copy to .env and adjust. Never commit real secrets.
# APP_ENV=production makes the server refuse to start with the default JWT secret.
APP_ENV=development
PORT=8080
# Ports match docker-compose.yml (5433/6380 to avoid clashing with a local pg/redis).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/analytics?sslmode=disable
REDIS_URL=redis://localhost:6380/0
CACHE_TTL_SECONDS=120
CORS_ORIGIN=http://localhost:3000
SEED_CSV_PATH=data/mock_logistics_data.csv

# AI interpretation for /ask. If GEMINI_API_KEY is empty, /ask uses the
# deterministic rule-based interpreter. Gemini only INTERPRETS questions into a
# structured plan; all figures are still computed from SQL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Auth. JWT_SECRET signs the login tokens — set a long random value in production.
# Tokens expire after JWT_TTL_HOURS (default 24h); every login issues a fresh one.
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=24

# Per-user rate limit on the AI /ask endpoint (protects Gemini cost/quota).
# Backed by Redis when available, in-memory otherwise.
ASK_RATE_LIMIT=15
ASK_RATE_WINDOW_SECONDS=60

# Input size limits.
MAX_BODY_BYTES=65536        # reject request bodies larger than this (64 KB)
MAX_QUESTION_CHARS=1000     # reject /ask questions longer than this

# dbmate reads DATABASE_URL too; point it at the same database.
DBMATE_MIGRATIONS_DIR=./db/migrations
DBMATE_SCHEMA_FILE=./db/schema.sql
